{
  "name": "lifebox-nextgen-client",
  "description": "LifeBox NextGen - Complete Employee Portal & Education Platform Frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "Syagam Reddy Bhanu Prakash Reddy",
    "email": "founder@lifeboxnextgen.com",
    "url": "https://www.lifeboxnextgen.com"
  },
  "homepage": "https://www.lifeboxnextgen.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/lifeboxnextgen/lifebox-nextgen.git"
  },
  "bugs": {
    "url": "https://github.com/lifeboxnextgen/lifebox-nextgen/issues"
  },
  "keywords": [
    "employee-portal",
    "education-platform",
    "react",
    "vite",
    "attendance-tracking",
    "performance-management",
    "learning-management-system",
    "enterprise-solution"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "build:prod": "NODE_ENV=production vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "eslint . --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext js,jsx,ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "analyze": "npm run build && npx vite-bundle-analyzer dist/stats.html",
    "clean": "rm -rf dist node_modules/.vite",
    "start": "npm run dev"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.26.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^13.24.0",
    "postcss": "^8.4.32",
    "vite": "^5.0.8"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "license": "MIT"
}
