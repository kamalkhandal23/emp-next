# LifeBox NextGen Client Environment Configuration

# API Configuration
VITE_API_URL=http://localhost:5002/api
VITE_API_TIMEOUT=30000

# Application Configuration
VITE_APP_NAME=LifeBox NextGen
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Complete Employee Portal & Education Platform

# Environment
VITE_NODE_ENV=development

# Feature Flags
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false
VITE_ENABLE_PERFORMANCE_MONITORING=false

# Authentication
VITE_JWT_STORAGE_KEY=authToken
VITE_REFRESH_TOKEN_KEY=refreshToken
VITE_SESSION_TIMEOUT=3600000

# File Upload
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# Pagination
VITE_DEFAULT_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100

# Date/Time Format
VITE_DATE_FORMAT=DD/MM/YYYY
VITE_TIME_FORMAT=HH:mm
VITE_DATETIME_FORMAT=DD/MM/YYYY HH:mm

# Notification Settings
VITE_NOTIFICATION_TIMEOUT=5000
VITE_ENABLE_BROWSER_NOTIFICATIONS=true

# Theme Configuration
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=true

# Company Information
VITE_COMPANY_NAME=LifeBox NextGen Pvt. Ltd.
VITE_COMPANY_EMAIL=info@lifeboxnextgen.com
VITE_COMPANY_PHONE=+91-XXXXXXXXXX
VITE_COMPANY_ADDRESS=Kakinada, Andhra Pradesh, India
VITE_COMPANY_WEBSITE=https://www.lifeboxnextgen.com

# Social Media Links
VITE_SOCIAL_FACEBOOK=https://facebook.com/lifeboxnextgen
VITE_SOCIAL_TWITTER=https://twitter.com/lifeboxnextgen
VITE_SOCIAL_LINKEDIN=https://linkedin.com/company/lifeboxnextgen
VITE_SOCIAL_INSTAGRAM=https://instagram.com/lifeboxnextgen

# Google Analytics (if enabled)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry Error Reporting (if enabled)
# VITE_SENTRY_DSN=https://xxxxxxxxxx@sentry.io/xxxxxxxxxx

# Map Configuration (if using maps)
# VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Payment Gateway (if using payments)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxx
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx

# Email Configuration (for contact forms)
VITE_CONTACT_EMAIL=contact@lifeboxnextgen.com
VITE_SUPPORT_EMAIL=support@lifeboxnextgen.com

# Development Tools
VITE_ENABLE_REDUX_DEVTOOLS=true
VITE_ENABLE_REACT_DEVTOOLS=true

# Performance
VITE_ENABLE_SERVICE_WORKER=true
VITE_CACHE_DURATION=86400000

# Security
VITE_ENABLE_CSP=true
VITE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5002

# Localization
VITE_DEFAULT_LANGUAGE=en
VITE_SUPPORTED_LANGUAGES=en,hi,te

# Employee Portal Specific
VITE_ATTENDANCE_GRACE_PERIOD=15
VITE_MAX_BREAK_DURATION=60
VITE_OVERTIME_THRESHOLD=8
VITE_LATE_THRESHOLD=15

# Education Platform Specific
VITE_EXAM_TIME_LIMIT=3600
VITE_PASSING_SCORE=60
VITE_MAX_ATTEMPTS=3

# Backup and Sync
VITE_AUTO_SAVE_INTERVAL=30000
VITE_SYNC_INTERVAL=300000